{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/viggomeesters/quick-vault-retriever/schemas/evidence-packet.schema.json",
  "title": "Quick Vault evidence packet",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "status", "query_hash", "terms", "count", "limit", "freshness", "elapsed_ms", "hits", "answer"],
  "properties": {
    "schema": {"const": "quick-vault.evidence-packet.v2"},
    "status": {"enum": ["ok", "partial", "not_found"]},
    "query_hash": {"type": "string", "pattern": "^[a-f0-9]{16}$"},
    "terms": {"type": "array", "maxItems": 12, "items": {"type": "string", "minLength": 2}, "uniqueItems": true},
    "count": {"type": "integer", "minimum": 0, "maximum": 20},
    "limit": {"type": "integer", "minimum": 1, "maximum": 20},
    "freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "projection_sequence", "canonical_sequence"],
      "properties": {
        "status": {"const": "fresh"},
        "projection_sequence": {"type": "integer", "minimum": 0},
        "canonical_sequence": {"type": "integer", "minimum": 0}
      }
    },
    "elapsed_ms": {"type": "number", "minimum": 0},
    "hits": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "record_type", "label", "citation_uri", "snippet", "matched_terms", "term_coverage", "score"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "record_type": {"type": "string", "minLength": 1},
          "label": {"type": "string", "minLength": 1, "maxLength": 160},
          "citation_uri": {"type": "string", "pattern": "^jsonl://record/.+"},
          "snippet": {"type": "string", "maxLength": 800},
          "matched_terms": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "term_coverage": {"type": "number", "minimum": 0, "maximum": 1},
          "score": {"type": "number"}
        }
      }
    },
    "answer": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "field", "text", "citation_uri"],
          "properties": {
            "kind": {"const": "extracted_value"},
            "field": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
            "text": {"type": "string", "minLength": 1, "maxLength": 160},
            "citation_uri": {"type": "string", "pattern": "^jsonl://record/.+"}
          }
        }
      ]
    }
  }
}
